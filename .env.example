# RSSHub is included in docker-compose.yml.
RSSHUB_BASE=http://rsshub:1200

# X API v2 bearer token. Used for the worldwide Trends endpoint.
X_BEARER_TOKEN=

# Required by the Xiaohongshu RSSHub route. Copy the Cookie header from a
# logged-in browser session. Never expose this value to the frontend.
XIAOHONGSHU_COOKIE=

# Comma-separated 24-character creator IDs. Their RSS feeds are merged and
# ranked by likes to form the local "popular posts" pool.
XIAOHONGSHU_USER_IDS=

# Optional. Useful for RSSHub routes that call GitHub.
GITHUB_ACCESS_TOKEN=
