{
  "name": "ai-news-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 0.0.0.0",
    "build": "node scripts/prepare-static.mjs && vitepress build docs",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "refresh": "node --env-file-if-exists=.env scripts/refresh.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=20"
  }
}
